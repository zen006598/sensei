# Telegram
TELEGRAM_TOKEN=7xxxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AnkiWeb credentials
ANKIWEB_EMAIL=user@example.com
ANKIWEB_PASSWORD=yourpassword

# Google Gemini API
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Path on the server where collection.anki2 lives
# The bot will read/write this file and sync it with AnkiWeb
ANKI_DATA_PATH=/home/youruser/anki-data

# Comma-separated Telegram user IDs allowed to use the bot
# Leave empty to allow all users (not recommended)
# Get your ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=123456789

# Optional: override defaults
# ANKI_COLLECTION_PATH=/data/anki/collection.anki2
# Hour-of-day (0–23) for the daily tag-backfill job
# SCHEDULER_DAILY_HOUR=3
# Hour-of-day (0–23) for the daily TTS pronunciation job
# TTS_DAILY_HOUR=4

# Piper voice model location and name. Voice file goes in a mounted
# volume; image stays slim. Match PIPER_VOICE to the file's basename.
# PIPER_VOICE_PATH=/data/piper/en_US-libritts-high.onnx
# PIPER_VOICE=en_US-libritts-high

# Anki media directory (where generated MP3s land). Default works with
# the existing anki_data volume mount.
# ANKI_MEDIA_PATH=/data/anki/collection.media
# MAX_CARDS_PER_SESSION=20
# GEMINI_TIMEOUT=30
